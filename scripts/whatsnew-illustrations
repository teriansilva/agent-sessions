# --- EDIT IN PLACE -----------------------------------------------------------------------------
def editing():
    b = [BOX(28, 56, 584, 250, fill="s3"), BOX(28, 56, 584, 26, fill="bg1"),
         T(40, 73, "retry.py"), T(96, 73, "src/upload", "t3", 9.5)]
    b.append(G("b20_67", T(462, 73, "UNSAVED EDITS", "warn", 9, ls=1)))
    b.append(G("a70", LED(470, 69.5), T(480, 73, "SAVED 14:02", "ok", 9, ls=1)))
    b.append(BTN(560, 61, 44, 16, "SAVE", size=8.5) + FLASH(560, 61, 44, 16, 33))

    code = [
        [S("def ", "kw"), S("upload", "t1"), S("(path, retries=", "t2"), S("3", "num"), S("):", "t2")],
        [S("    for ", "kw"), S("attempt ", "t1"), S("in ", "kw"), S("range", "t1"), S("(retries):", "t2")],
        [S("        try", "kw"), S(":", "t2")],
        [S("            return ", "kw"), S("send", "t1"), S("(path)", "t2")],
        [S("        except ", "kw"), S("TimeoutError", "ty"), S(":", "t2")],
        None,  # the edited line
        [S("    raise ", "kw"), S("UploadFailed", "ty"), S("(path)", "t2")],
    ]
    for i, parts in enumerate(code):
        y = 104 + i * 20
        b.append(T(58, y, str(i + 1), "t3", 10, anchor="end"))
        if parts:
            b.append(T(72, y, "".join(parts), size=11, raw=True, pre=True))
    b.append(G("a8", R(29, 190, 583, 20, "bg2")))
    b.append(T(58, 204, "6", "t3", 10, anchor="end"))
    b.append(G("d10", T(72, 204, "".join([S("            sleep", "t1"), S("(", "t2"), S("1", "num"), S(")", "t2")]), size=11, raw=True, pre=True)))
    new = T(72, 204, "".join([S("            sleep", "t1"), S("(", "t2"), S("2", "num"), S(" ** attempt)", "t2")]), size=11, raw=True, pre=True)
    b.append(CLIP("ed1", 150, 192, 130, 16) + f'<g clip-path="url(#ed1)"><g class="fo">{new}' + R(150, 192, 130, 16, "bg2", cls="ty11_21_134") + "</g></g>")
    b.append(f'<g clip-path="url(#ed0)">{CLIP("ed0", 72, 192, 78, 16)}<g class="a11">{new}</g></g>')
    b.append(R(279, 194, 1.5, 13, "ac", cls="cur"))

    b.append(G("b37_66",
               R(40, 236, 560, 60, "bg2"), R(40, 236, 3, 60, "warn"),
               T(54, 256, "CHANGED ON DISK — the agent wrote this file while you edited"),
               BTN(54, 268, 128, 20, "RELOAD FROM DISK", "ghost", 8.5),
               BTN(190, 268, 150, 20, "OVERWRITE WITH MINE", size=8.5),
               FLASH(190, 268, 150, 20, 60)))
    b.append(G("a67",
               R(40, 236, 560, 60, "bg2"), R(40, 236, 3, 60, "ok"),
               T(54, 258, "BOTH VERSIONS KEPT", "ok", 10.5, weight=700, ls=1),
               T(54, 278, "yours is saved; the disk copy went to the recovery store", "t2", 10)))

    right = T(612, 40, "FILES → retry.py → EDIT", "t2", 10, anchor="end")
    frame("editing", "Edit in place: a change typed into the file viewer; the agent changed the file meanwhile, so the save stops, and after the operator chooses, both versions are kept",
          "EDIT IN PLACE", right, "EDIT IN PLACE // a save that cannot lose the agent's work", "".join(b))



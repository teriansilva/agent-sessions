    for x, code, color, name in chips:
        b.append(BOX(x, 222, 84, 22) + BADGE(x + 8, 227, code, color) + T(x + 32, 237, name, "t2", 10))
    b.append(G("a54", BOX(324, 222, 84, 22, fill="none", stroke="ac")))
    b.append(BTN(532, 256, 80, 22, "SEND →", "solid") + FLASH(532, 256, 80, 22, 66))
    b.append(G("a72", LED(330, 294), T(342, 298, "sent to claude · upload", "t2", 10)))

    right = T(612, 40, "/templates", "t2", 10, anchor="end")
    frame("templates", "Templates: a saved instruction is picked from the library, its fields are filled in, and it is sent to a chosen session",
          "TEMPLATES", right, "TEMPLATES // write it once, fill the blanks, send it anywhere", "".join(b))


if __name__ == "__main__":
    for target in sys.argv[1:] or [OUT]:
        OUT = os.path.abspath(target)
        os.makedirs(OUT, exist_ok=True)
        missions()
        files()
        editing()
        templates()
        print("wrote", OUT, sorted(f for f in os.listdir(OUT) if f.endswith(".svg")))

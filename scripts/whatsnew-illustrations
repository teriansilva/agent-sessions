#!/usr/bin/env python3
"""Generate the v0.20 "What's new" illustrations (#971): self-contained animated SVGs (640x360).

    scripts/whatsnew-illustrations [OUT_DIR ...]      # default: web/public/whatsnew/0.20

One source for every copy — the in-app slides, and later the landing page and docs — so they
cannot drift. Each illustration is written twice: ``<name>.svg`` plays its story ONCE (~10 s) and
rests on its final frame, and ``<name>-still.svg`` has no animation at all (the Pause toggle's
target). Under prefers-reduced-motion the animated file starts on that final frame too.

Each element's timeline is encoded in a class token and the keyframes are derived from the tokens
actually used, so a timing lives in exactly one place:

  aN        appear at N% of the pass and stay                            (final state: shown)
  dN        shown until N%, then gone                                     (final state: hidden)
  bN_M      appear at N%, gone at M%                                      (final state: hidden)
  pN        a press flash at N%                                           (final state: hidden)
  tyS_E_DX  typing cover: slides DX px right between S% and E%            (final state: revealed)
  pgS_E     progress bar: scaleX 0 -> 1 between S% and E%                 (final state: full)
  flyN      a file dropping in at N%                                      (final state: hidden)
  fo        a typed group (kept for readability; no animation of its own)

Only opacity, transform and stroke-dashoffset animate — never geometry or clip-path. A standalone
image cannot read CSS variables, so colours are the dark web/src/tokens.css values as literals,
like web/public/onboarding/*.svg.
"""
import html
import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "web", "public", "whatsnew", "0.20")
LOOP = 10  # seconds

C = dict(
    bg1="#131418", bg0="#0d0e10", bg2="#1a1c21", s3="#08090b", line="#25282e",
    t1="#e8e9ec", t2="#a7abb3", t3="#6f747d", ac="#ffb000", ink="#120c00",
    ok="#3fbf6f", warn="#f59e0b", kw="#c4a7ff", st="#d9c7a0", num="#f2a8c4",
    com="#8b9099", ty="#8fd3c7", prop="#b9bec7", teal="#2dd4bf", white="#ffffff",
)


def col(c):
    return C.get(c, c)


def T(x, y, s, fill="t1", size=10.5, anchor=None, weight=None, ls=None, raw=False, pre=False, cls=None):
    attrs = [f'x="{x}"', f'y="{y}"', f'fill="{col(fill)}"', f'font-size="{size}"']
    if anchor:
        attrs.append(f'text-anchor="{anchor}"')
    if weight:
        attrs.append(f'font-weight="{weight}"')
    if ls:
        attrs.append(f'letter-spacing="{ls}"')
    if pre:
        attrs.append('xml:space="preserve" style="white-space:pre"')
    if cls:
        attrs.append(f'class="{cls}"')
    body = s if raw else html.escape(s, quote=False)
    return f"<text {' '.join(attrs)}>{body}</text>"


def S(s, fill):
    return f'<tspan fill="{col(fill)}">{html.escape(s, quote=False)}</tspan>'


def LBL(x, y, s):
    return T(x, y, s, "t3", 9, ls=1.5)


def BOX(x, y, w, h, fill="bg0", stroke="line", extra=""):
    return f'<rect x="{x + .5}" y="{y + .5}" width="{w}" height="{h}" fill="{col(fill)}" stroke="{col(stroke)}"{extra}/>'


def R(x, y, w, h, fill, cls=None, extra=""):
    c = f' class="{cls}"' if cls else ""
    return f'<rect x="{x}" y="{y}" width="{w}" height="{h}" fill="{col(fill)}"{c}{extra}/>'


def G(cls, *parts):
    return f'<g class="{cls}">' + "".join(parts) + "</g>"


def BADGE(x, y, code, color):
    return R(x, y, 18, 12, color) + T(x + 9, y + 9, code, "ink", 7.5, anchor="middle", weight=700)


def BTN(x, y, w, h, label, kind="outline", size=9):
    ty = y + h / 2 + size * 0.36
    if kind == "solid":
        return R(x, y, w, h, "ac") + T(x + w / 2, ty, label, "ink", size, anchor="middle", weight=700, ls=1)
    if kind == "ghost":
        return BOX(x, y, w, h, fill="none", stroke="line") + T(x + w / 2, ty, label, "t2", size, anchor="middle", ls=1)
    return (BOX(x, y, w, h, fill="none", stroke="ac", extra=' stroke-opacity=".55"')
            + T(x + w / 2, ty, label, "ac", size, anchor="middle", ls=1))


def FLASH(x, y, w, h, n):
    return R(x, y, w, h, "white", cls=f"p{n}", extra=' fill-opacity=".38"')


def CHECKBOX(x, y, fill_n=None, fill="ok"):
    box = BOX(x, y, 11, 11, fill="none", stroke="t3")
    if fill_n is None:
        return box
    return box + G(f"a{fill_n}", R(x, y, 12, 12, fill),
                   f'<path d="M{x + 2.5} {y + 6} l2.6 2.6 4.6 -5.2" fill="none" stroke="{C["ink"]}" stroke-width="1.8"/>')


def CLIP(cid, x, y, w, h):
    return f'<clipPath id="{cid}"><rect x="{x}" y="{y}" width="{w}" height="{h}"/></clipPath>'


def TYPE(cid, x, y, w, h, text, s, e, cover="bg0"):
    """A line of text revealed left to right between s% and e%."""
    return (CLIP(cid, x, y, w, h)
            + f'<g clip-path="url(#{cid})"><g class="fo">{text}'
            + R(x, y, w, h, cover, cls=f"ty{s}_{e}_{w + 4}")
            + "</g></g>")


def ARROW(x1, x2, y, n):
    return G(f"a{n}", f'<path d="M{x1} {y} H{x2}" stroke="{C["ac"]}" stroke-width="1.5" class="flow"/>',
             f'<path d="M{x2 - 4} {y - 4} l5 4 -5 4" fill="none" stroke="{C["ac"]}" stroke-width="1.5"/>')


def LED(cx, cy, color="ok"):
    return f'<circle cx="{cx}" cy="{cy}" r="3.5" fill="{col(color)}" class="led"/>'


# ---------------------------------------------------------------------------------------------
def keyframes(body):
    """Keyframes for one PASS of the story (#971 review): every timeline runs once and its 100%
    keyframe IS the final frame — the same frame reduced motion shows — so the image comes to rest
    on its own. Ambient effects (LED, cursor, dashes) are bounded to the same ~10 s."""
    tokens = set()
    for m in re.finditer(r'class="([^"]+)"', body):
        tokens.update(m.group(1).split())
    once = f"{LOOP}s 1 both"
    css = []
    for t in sorted(tokens):
        if m := re.fullmatch(r"a(\d+)", t):
            n = int(m.group(1))
            css.append(f"@keyframes {t}{{0%,{n}%{{opacity:0}}{n + 3}%,100%{{opacity:1}}}}"
                       f".{t}{{animation:{t} {once}}}")
        elif m := re.fullmatch(r"d(\d+)", t):
            n = int(m.group(1))
            css.append(f"@keyframes {t}{{0%,{n}%{{opacity:1}}{n + 3}%,100%{{opacity:0}}}}"
                       f".{t}{{opacity:0;animation:{t} {once}}}")
        elif m := re.fullmatch(r"b(\d+)_(\d+)", t):
            n, k = int(m.group(1)), int(m.group(2))
            css.append(f"@keyframes {t}{{0%,{n}%{{opacity:0}}{n + 3}%,{k}%{{opacity:1}}{k + 3}%,100%{{opacity:0}}}}"
                       f".{t}{{opacity:0;animation:{t} {once}}}")
        elif m := re.fullmatch(r"p(\d+)", t):
            n = int(m.group(1))
            css.append(f"@keyframes {t}{{0%,{n}%{{opacity:0}}{n + 1}%{{opacity:1}}{n + 6}%,100%{{opacity:0}}}}"
                       f".{t}{{opacity:0;animation:{t} {once}}}")
        elif m := re.fullmatch(r"ty(\d+)_(\d+)_(\d+)", t):
            s, e, dx = (int(v) for v in m.groups())
            css.append(f"@keyframes {t}{{0%,{s}%{{transform:translateX(0)}}{e}%,100%{{transform:translateX({dx}px)}}}}"
                       f".{t}{{transform:translateX({dx}px);animation:{t} {LOOP}s steps(18,end) 1 both}}")
        elif m := re.fullmatch(r"pg(\d+)_(\d+)", t):
            s, e = int(m.group(1)), int(m.group(2))
            css.append(f"@keyframes {t}{{0%,{s}%{{transform:scaleX(0)}}{e}%,100%{{transform:scaleX(1)}}}}"
                       f".{t}{{transform-box:fill-box;transform-origin:left center;animation:{t} {LOOP}s ease-in-out 1 both}}")
        elif m := re.fullmatch(r"fly(\d+)", t):
            n = int(m.group(1))
            css.append(f"@keyframes {t}{{0%,{n}%{{opacity:0;transform:translateY(-42px)}}{n + 3}%{{opacity:1;transform:translateY(-42px)}}"
                       f"{n + 11}%{{opacity:1;transform:translateY(0)}}{n + 14}%,100%{{opacity:0;transform:translateY(0)}}}}"
                       f".{t}{{opacity:0;animation:{t} {LOOP}s ease-in 1 both}}")
        elif t == "fo":
            pass  # a typed group stays shown: with one pass there is no loop end to fade into
        elif t == "led":
            css.append("@keyframes led{0%,100%{opacity:1}50%{opacity:.35}}.led{animation:led 1.6s ease-in-out 6}")
        elif t == "cur":
            css.append("@keyframes cur{50%{opacity:0}}.cur{animation:cur 1s steps(1,end) 10}")
        elif t == "flow":
            css.append("@keyframes flow{to{stroke-dashoffset:-8}}.flow{stroke-dasharray:4 4;animation:flow .8s linear 12}")
        else:
            sys.exit(f"unknown timeline token: {t}")
    return "".join(css)


def frame(name, label, title, right, caption, body):
    """Writes `<name>.svg` (one pass, then rest) and `<name>-still.svg` (no animation at all — the
    Pause toggle's target). Both share the markup, so the still is exactly the final frame."""
    for suffix, motion in (("", keyframes(body) + "@media (prefers-reduced-motion:reduce){*{animation:none!important}}"),
                           ("-still", "*{animation:none!important}")):
        style = 'text{font-family:"JetBrains Mono","DejaVu Sans Mono","Liberation Mono",ui-monospace,monospace}' + motion
        if suffix:
            style = keyframes(body) + style  # keep the base (final-state) rules; kill every animation
        svg = (f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="640" height="360" role="img" aria-label="{html.escape(label)}">'
               f"<!-- BattleLab v0.20 illustration: {name}{suffix}. Generated by scripts/whatsnew-illustrations (#971); standalone, so colours are the dark tokens.css values. -->"
               f"<style>{style}</style>"
               + R(0, 0, 640, 360, "bg1")
               + f'<g stroke="{C["ac"]}" stroke-width="2" fill="none"><path d="M8 20V8h12"/><path d="M620 8h12v12"/><path d="M8 340v12h12"/><path d="M632 340v12h-12"/></g>'
               + T(28, 40, title, "ac", 10.5, weight=700, ls=2)
               + right
               + body
               + T(320, 338, caption, "t3", 11, anchor="middle")
               + "</svg>\n")
        with open(os.path.join(OUT, f"{name}{suffix}.svg"), "w") as f:
            f.write(svg)



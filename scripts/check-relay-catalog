#!/usr/bin/env python3
"""Read-only rollout gate: exact GitHub/relay bytes, clean and legacy-cached isolated clients.

Run with this checkout's venv. Never reads/writes the operator's plugin state, starts vendor
processes, imports private signing keys or enables agents. Local install/verify/enable must
also pass its existing isolated regression suite before cutover; record live acceptance in #1370.
"""

from __future__ import annotations

import asyncio
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))


async def relay():
    import httpx

    from agent_sessions.plugins import feed

    base = "https://relay.battlelab.superstatus.io/catalogs/agents/v1"

    async def get(client, url, limit):
        client.cookies.clear()
        async with client.stream("GET", url) as response:
            if response.status_code != 200:
                raise ValueError("Relay read refused (including redirects)")
            data = bytearray()
            async for chunk in response.aiter_bytes():
                data.extend(chunk)
                if len(data) > limit:
                    raise ValueError("Relay response too large")
            return bytes(data)

    async with asyncio.timeout(30):
        async with httpx.AsyncClient(trust_env=False, follow_redirects=False, timeout=10) as client:
            selected = feed.decode(await get(client, base + "/current.json", 1024))
            if (
                set(selected) != {"sequence", "digest"}
                or type(selected["sequence"]) is not int
                or not 0 < selected["sequence"] <= 9999999999999999
                or not isinstance(selected["digest"], str)
                or not re.fullmatch(r"[0-9a-f]{64}", selected["digest"])
            ):
                raise ValueError("Relay descriptor invalid")
            cut = f"{base}/releases/{selected['sequence']}-{selected['digest']}/plugin-feed.json"
            data = await get(client, cut, feed.MAX_BYTES)
            signature = await get(client, cut + ".sig", 16384)
    feed.verify(data, signature)
    snapshot = feed.parse(data)
    if selected != {"sequence": snapshot.sequence, "digest": snapshot.digest}:
        raise ValueError("Relay cut does not match descriptor")
    return data, signature


def main():
    # Clear inherited production configuration before importing any application module.
    for name in list(os.environ):
        if name.startswith("AGENT_SESSIONS_"):
            del os.environ[name]
    with tempfile.TemporaryDirectory(prefix="battlelab-catalog-rollout-") as directory:
        os.environ["AGENT_SESSIONS_HOME"] = directory
        if len(sys.argv) == 3 and sys.argv[1] in ("clean", "cached"):
            from agent_sessions.plugins import feed, feed_client, storage

            pair = Path(sys.argv[2])
            data = (pair / "plugin-feed.json").read_bytes()
            signature = (pair / "plugin-feed.json.sig").read_bytes()
            if sys.argv[1] == "cached":
                feed.accept(data, signature)
            accepted = asyncio.run(feed_client.refresh())
            expected = feed.parse(data)
            if accepted.digest != expected.digest or accepted.sequence != expected.sequence:
                raise ValueError("Relay/GitHub identity differs")
            # Compare exact canonical bytes and signature in the persisted envelope.
            state = storage.read(storage.root() / "feed.json")
            if state["data"] != data.decode() or state["signature"] != signature.decode():
                raise ValueError("Relay/GitHub bytes differ")
            print(
                f"{sys.argv[1]} client accepted sequence {accepted.sequence}, "
                f"digest {accepted.digest}"
            )
            return
        data, signature = asyncio.run(relay())
        pair = Path(directory)
        (pair / "plugin-feed.json").write_bytes(data)
        (pair / "plugin-feed.json.sig").write_bytes(signature)
        for mode in ("clean", "cached"):
            subprocess.run(  # noqa: S603 — re-run this script with fixed modes in isolated state
                [sys.executable, str(Path(__file__).resolve()), mode, str(pair)], check=True
            )
        print("PASS: GitHub and relay signed bytes match for both isolated client states.")


if __name__ == "__main__":
    main()

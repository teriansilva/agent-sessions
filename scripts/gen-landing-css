#!/usr/bin/env python3
"""Write landing/nightjar.css: battlelabos.com's sub-page stylesheet (#1597, epic #1531 Phase 12b).

ONE palette: the tokens are copied verbatim from web/src/tokens.css (its bare `:root` block, the
dark default — the public site is dark-only), never restated by hand. After them come the
self-hosted fonts and the landing primitives (scripts/landing-primitives.css).

    scripts/gen-landing-css           write landing/nightjar.css
    scripts/gen-landing-css --check   exit 1 if landing/nightjar.css is not what this would write

tests/test_landing_pages.py runs --check, so a token change that is not regenerated fails CI.
"""

from __future__ import annotations

import pathlib
import re
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
TOKENS = REPO / "web" / "src" / "tokens.css"
PRIMITIVES = REPO / "scripts" / "landing-primitives.css"
OUT = REPO / "landing" / "nightjar.css"

HEADER = """\
/* battlelabos.com — NIGHTJAR for the sub-pages (legal, privacy, 404). GENERATED by
 * scripts/gen-landing-css from web/src/tokens.css (the app's one palette, its dark :root) and
 * scripts/landing-primitives.css. Do not edit by hand: edit those and re-run the script.
 * index.html keeps its own inline copy until #1544 closes. */
"""

# The landing's self-hosted woff2 files, registered under the app's family names so the tokens'
# --font-display / --font-mono stacks resolve to them.
_FACES = [
    ("BattleLab Display", "500", "/chakra-petch-500.woff2"),
    ("BattleLab Display", "600", "/chakra-petch-600.woff2"),
    ("BattleLab Mono", "100 800", "/jetbrains-mono.woff2"),
]
FONTS = "".join(
    f'@font-face {{ font-family: "{family}"; font-style: normal; font-weight: {weight}; '
    f'font-display: swap; src: url({url}) format("woff2"); }}\n'
    for family, weight, url in _FACES
)


def dark_root(tokens_css: str) -> str:
    """The first bare `:root { … }` block of tokens.css (the dark default), verbatim."""
    m = re.search(r"^:root \{\n.*?^\}\n", tokens_css, flags=re.S | re.M)
    if not m:
        raise SystemExit("gen-landing-css: no bare :root block in web/src/tokens.css")
    return m.group(0)


def render() -> str:
    tokens = dark_root(TOKENS.read_text())
    primitives = PRIMITIVES.read_text()
    banner = "/* ---- tokens: web/src/tokens.css, the dark :root ---- */"
    return f"{HEADER}\n{FONTS}\n{banner}\n{tokens}\n{primitives}"


def main(argv: list[str]) -> int:
    text = render()
    if "--check" in argv:
        if not OUT.exists() or OUT.read_text() != text:
            print("landing/nightjar.css is stale: run scripts/gen-landing-css", file=sys.stderr)
            return 1
        return 0
    OUT.write_text(text)
    print(f"wrote {OUT.relative_to(REPO)} ({len(text)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

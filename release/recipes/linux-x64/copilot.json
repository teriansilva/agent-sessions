{
    "manifest": {
        "binary": {
            "aliases": [
                "npm-loader.js"
            ],
            "env_var": "AGENT_SESSIONS_COPILOT_BIN",
            "name": "copilot",
            "search_npm_global": true,
            "search_paths": [
                "~/.local/bin"
            ],
            "version_flag": "--version"
        },
        "capabilities": {
            "archive": true,
            "handoff_target": true,
            "new": true,
            "orchestrator_input": true,
            "raw_tty": true,
            "resume": true,
            "seed_start": true
        },
        "contract": 1,
        "display": {
            "accent": "teal",
            "badge": "cp",
            "name": "copilot",
            "order": 45
        },
        "identity": {
            "id": "copilot",
            "label": "GitHub Copilot CLI",
            "publisher": "battlelab",
            "version": "1.0.70"
        },
        "install": {
            "authority": "registry.npmjs.org",
            "digest": "sha256:903343fc2f8bc26bf056e0714a05b9bba7cac8f9812408e74499ddcfbed9d570",
            "entrypoint": "node_modules/@github/copilot-linux-x64/copilot",
            "kind": "npm-prefix",
            "package": "@github/copilot-linux-x64",
            "platform": "linux-x64",
            "version": "1.0.70"
        },
        "instructions": {
            "files": [
                "AGENTS.md",
                "CLAUDE.md"
            ]
        },
        "launch": {
            "base_args": [
                "--no-auto-update"
            ],
            "bypass": [
                "--yolo"
            ],
            "model": {
                "flag": "--model",
                "kind": "flag",
                "on_resume": true
            },
            "new": {
                "flag": "--session-id",
                "kind": "pin-flag"
            },
            "resume": {
                "flag": "--resume",
                "kind": "flag"
            }
        },
        "models": {
            "list": [
                {
                    "id": "gpt-5.5"
                }
            ]
        },
        "probe": {
            "kind": "copilot-prompt-pinned"
        },
        "session_id": {
            "mint": "pinned",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "signin": {
            "kind": "cli-subcommand",
            "subcommand": "login"
        },
        "store": {
            "layout": "copilot-sessions",
            "paths": {
                "archive": "session-state-archive",
                "sessions": "session-state"
            },
            "root": "~/.copilot"
        },
        "tools": {
            "mcp": "copilot-additional-mcp-config"
        },
        "transcript": {
            "kind": "copilot-events"
        },
        "unattended": {
            "start_evidence": "copilot-sessions"
        },
        "usage": {
            "access": "copilot-acp-auth",
            "source": "manual"
        },
        "verify": [
            "binary",
            "version",
            "store",
            "new",
            "resume",
            "transcript",
            "usage"
        ]
    },
    "recipe": {
        "artifacts": [
            {
                "destination": "node_modules/@github/copilot-linux-x64",
                "sha256": "903343fc2f8bc26bf056e0714a05b9bba7cac8f9812408e74499ddcfbed9d570",
                "url": "https://registry.npmjs.org/@github/copilot-linux-x64/-/copilot-linux-x64-1.0.70.tgz"
            }
        ]
    }
}

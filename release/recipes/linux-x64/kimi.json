{
  "manifest": {
    "binary": {
      "aliases": [
        "main.mjs"
      ],
      "env_var": "AGENT_SESSIONS_KIMI_BIN",
      "name": "kimi",
      "search_paths": [
        "~/.kimi-code/bin",
        "~/.local/bin"
      ],
      "version_flag": "--version"
    },
    "capabilities": {
      "archive": true,
      "handoff_target": true,
      "new": true,
      "orchestrator_input": true,
      "raw_tty": true,
      "resume": true,
      "seed_start": true
    },
    "contract": 1,
    "display": {
      "accent": "magenta",
      "badge": "ki",
      "id_prefix": "session_",
      "name": "kimi",
      "order": 60
    },
    "identity": {
      "id": "kimi",
      "label": "Kimi Code",
      "publisher": "battlelab",
      "version": "2.1.1"
    },
    "install": {
      "authority": "registry.npmjs.org",
      "digest": "sha256:6690a29d7b5e14812754dd100136b7f4ee2577add8895f00fe27025b4412049f",
      "entrypoint": "node_modules/@moonshot-ai/kimi-code/dist/main.mjs",
      "kind": "npm-prefix",
      "package": "@moonshot-ai/kimi-code",
      "platform": "linux-x64",
      "version": "2.1.1"
    },
    "instructions": {
      "files": [
        "AGENTS.md"
      ]
    },
    "launch": {
      "bypass": [
        "-y"
      ],
      "new": {
        "kind": "bare"
      },
      "resume": {
        "flag": "-S",
        "kind": "flag"
      }
    },
    "models": {
      "configured_elsewhere": true
    },
    "probe": {
      "kind": "prompt-session"
    },
    "session_id": {
      "mint": "adopt",
      "pattern": "^session_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "signin": {
      "kind": "cli-subcommand",
      "subcommand": "login"
    },
    "store": {
      "env_override": "AGENT_SESSIONS_KIMI_DIR",
      "layout": "kimi-code",
      "root": "~/.kimi-code"
    },
    "terminal": {
      "repaint": "wipe"
    },
    "transcript": {
      "kind": "kimi-wire"
    },
    "usage": {
      "access": "kimi-wire-auth-error",
      "kind": "kimi-web-usage-probe",
      "source": "plan"
    },
    "verify": [
      "binary",
      "version",
      "store",
      "new",
      "resume",
      "transcript",
      "usage"
    ]
  },
